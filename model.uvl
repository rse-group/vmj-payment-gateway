namespace PaymentGateway

imports
    interfaces.Vendor as V
    interfaces.Features as F

features
    PaymentGateway {abstract true}
        optional
            V.Vendor
            F.Features
            
constraints    
    F.PaymentLink => V.Oy | V.Midtrans | V.Flip
    F.EWallet | F.VirtualAccount => V.Oy | V.Midtrans | V.Flip | V.Xendit
    F.RetailOutlet => V.Oy | V.Midtrans | V.Xendit
    F.Invoice | F.PaymentRouting => V.Oy 
    F.Card => V.Midtrans
    F.SpecifiedRecipient | F.QRCode | F.DirectDebit => V.Xendit
    F.Agent | F.ExchangeRate | F.FixedCurrency => V.Flip