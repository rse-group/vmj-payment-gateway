namespace PaymentGateway

features
	PaymentGateway {abstract true}
		optional
			Vendor {abstract true}
				optional
					Flip
					Midtrans
					Oy
					Xendit
			Disbursement
				optional
					International {abstract true}
						or
							ExchangeRate
							FixedCurrency
					Agent
					SpecifiedRecipient
			Payment {abstract true}
				optional
					PaymentLink
					VirtualAccount
					RetailOutlet
					EWallet
					Invoice
					PaymentRouting
					Card
					DirectDebit
					QRCode

constraints
	Oy => PaymentLink | EWallet | VirtualAccount | RetailOutlet | Invoice | PaymentRouting
	Midtrans => Card | VirtualAccount | RetailOutlet | PaymentLink | EWallet
	Xendit => SpecifiedRecipient | VirtualAccount | RetailOutlet | DirectDebit | QRCode
	Flip => Agent | ExchangeRate | FixedCurrency | PaymentLink | VirtualAccount | EWallet
