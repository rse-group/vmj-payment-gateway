namespace PaymentGateway

imports
	featureModels.Vendor as V
	featureModels.Features as F

features
	PaymentGateway {abstract true}
		optional
			V.Vendor
			F.Features

constraints
	V.Oy => F.PaymentLink & F.EWallet & F.VirtualAccount & F.RetailOutlet & F.Invoice & F.PaymentRouting
	V.Midtrans => F.CreditCard & F.DebitCard & F.VirtualAccount & F.RetailOutlet & F.PaymentLink & F.EWallet
	V.Xendit => F.SpecifiedRecipient
	V.Flip => F.Agent & F.ExchangeRate & F.FixedCurrency & F.PaymentLink & F.VirtualAccount
