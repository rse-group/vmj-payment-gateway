namespace PaymentGateway

imports
	interfaces.Vendor as V
	interfaces.Features as F

features
	PaymentGateway {abstract true}
		optional
			V.Vendor
			F.Features

constraints
    F.PaymentLink => V.Oy | V.Midtrans | V.Flip
    F.EWallet => V.Oy | V.Midtrans | V.Flip | V.Xendit
    F.VirtualAccount => V.Oy | V.Midtrans | V.Flip | V.Xendit
    F.RetailOutlet => V.Oy | V.Midtrans | V.Xendit
    F.Invoice => V.Oy
    F.PaymentRouting => V.Oy 
    F.Card => V.Midtrans
    F.QRCode => V.Xendit
    F.SpecifiedRecipient => V.Xendit
    F.DirectDebit => V.Xendit
    F.Agent => V.Flip
    F.ExchangeRate => V.Flip
    F.FixedCurrency => V.Flip