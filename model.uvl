namespace PaymentGateway

features
	PaymentGateway {abstract true}
		optional
			Vendor {abstract true}
				optional
					Flip
					Midtrans
					Oy
					Xendit
			Disbursement
				optional
					International {abstract true}
						or
							ExchangeRate
							FixedCurrency
					Agent
					SpecifiedRecipient
			Payment {abstract true}
				or
					PaymentLink
					VirtualAccount
					RetailOutlet
					EWallet
					Invoice
					PaymentRouting
					CreditCard
					DebitCard

constraints
  Disbursement => Flip | Xendit
  PaymentLink | EWallet => Oy | Midtrans | Flip
  VirtualAccount | RetailOutlet => Oy | Midtrans
  Invoice | PaymentRouting => Oy
  CreditCard | DebitCard  => Midtrans
  SpecifiedRecipient => Xendit
  Agent | ExchangeRate | FixedCurrency => Flip
