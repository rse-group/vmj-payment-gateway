namespace PaymentGateway

features
	PaymentGateway {abstract true}
		optional
			Vendor {abstract true}
				optional
					Flip
					Midtrans
					Oy
					Xendit
			Disbursement
				optional
					International {abstract true}
						or
							ExchangeRate
							FixedCurrency
					Agent
					SpecifiedRecipient
			Payment
				optional
					PaymentLink
					VirtualAccount
					RetailOutlet
					EWallet
					Invoice
					PaymentRouting
					Card
					DirectDebit

constraints
  PaymentLink | EWallet | VirtualAccount | RetailOutlet | Invoice | PaymentRouting => Oy
  Card | VirtualAccount | RetailOutlet | PaymentLink | EWallet => Midtrans
  SpecifiedRecipient | VirtualAccount | RetailOutlet | DirectDebit => Xendit
  Agent | ExchangeRate | FixedCurrency |  PaymentLink | VirtualAccount => Flip
