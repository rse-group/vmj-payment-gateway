namespace Features

features
	Features {abstract true}
		or
			Disbursement
				optional
					International {abstract true}
						or
							ExchangeRate
							FixedCurrency
					Agent
					SpecifiedRecipient
			Payment {abstract true}
				or
					PaymentLink
					VirtualAccount
					RetailOutlet
					EWallet
					Invoice
					PaymentRouting
					Card
					DirectDebit
					QRCode

